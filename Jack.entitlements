<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow sending Apple Events to other apps (for paste-to-active-app) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Required by the hardened runtime so meeting notes can request mic access. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required by the hardened runtime so reminders can be mirrored into Apple Reminders (EventKit). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
