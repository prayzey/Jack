{
  "manifest_version": 3,
  "name": "Jack Tab Volume",
  "description": "Lets Jack's menu bar sound panel set the volume of each browser tab that plays sound.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-volume.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
